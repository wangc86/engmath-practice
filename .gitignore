# 資料庫（內含學號與密碼雜湊，絕不可進版本控制）
*.db
*.db-wal
*.db-shm

# 環境變數（SESSION_SECRET）
.env
.env.*
!.env.example

# scripts/preview.py 的產出
preview.html
preview.tex
preview.pdf
preview.aux
preview.log
preview.out

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/

# 打包產出（給老師在 Windows 上部署測試用的 zip，見 WINDOWS-SETUP.md）。
# 內容可由版本控制完整重建，因此不進版控。
dist/

# 被移除的檔案的暫存地（見 CLAUDE.md「不能刪檔」）。
# 自動化工作階段的掛載點不允許 unlink，所以「刪掉一個檔案」實際上只能做到
# 「把它改名搬走」。搬到這裡等於從版本控制的角度真的消失了（本行忽略它），
# 而老師在自己的電腦上一行 `rm -rf .attic` 就能真的清掉。
# 這個資料夾裡的東西**沒有任何一個還在被程式碼引用**——引用得到就是還沒刪乾淨。
.attic/

# 編輯器與作業系統
.vscode/
.idea/
.DS_Store
