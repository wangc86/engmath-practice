# 複製為 .env 後修改（.env 已被 .gitignore 排除）
#
# Session cookie 的簽章金鑰。正式環境**必須**設定，否則每次重啟都會把所有人登出。
# 產生方式：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# SQLite 檔案位置（預設為專案根目錄的 practice.db）
# PRACTICE_DB=/var/lib/engmath/practice.db

# 走 HTTPS 時設為 1，讓 session cookie 加上 Secure 屬性
COOKIE_SECURE=0
