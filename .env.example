# 複製為 .env 後修改（.env 已被 .gitignore 排除）
#
# Session cookie 的簽章金鑰。正式環境**必須**設定，否則每次重啟都會把所有人登出。
# 產生方式：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# SQLite 檔案位置（預設為專案根目錄的 practice.db）
# PRACTICE_DB=/var/lib/engmath/practice.db

# 走 HTTPS 時設為 1，讓 session cookie 加上 Secure 屬性
COOKIE_SECURE=0

# --- 作答判定 -------------------------------------------------------------
# 判定跑在子行程裡（唯一能保證「一定回得來」的做法）。子行程叫不起來時服務會
# **拒絕啟動**，不會退回同行程執行——詳見 README〈運維：判定子行程池〉。
# GRADER_TIMEOUT=5
# GRADER_WORKERS=2
# GRADER_WARMUP=1              # 設 0 可跳過啟動自檢（判定仍會全部失敗，只是延後發現）
# GRADER_WARMUP_TIMEOUT=60

# app.* 的 log 等級。想看判定為什麼給不出提示之類的細節時設 DEBUG。
# APP_LOG_LEVEL=INFO
